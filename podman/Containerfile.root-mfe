# ==============================================================================
# DomoNow PropTech Platform - Single-SPA Root Orchestrator (Containerfile)
# Port: 9000 | Architecture: ARM64 Apple Silicon & x86_64
# ==============================================================================

FROM node:22-alpine

WORKDIR /app

# 1. Copy shared design tokens
COPY src/frontend/domonow-ui-tokens ./src/frontend/domonow-ui-tokens

# 2. Copy root-config package manifests and install dependencies
COPY src/frontend/root-config/package*.json ./src/frontend/root-config/
WORKDIR /app/src/frontend/root-config
RUN npm install

# 3. Copy source files
COPY src/frontend/root-config ./

EXPOSE 9000

ENV HOST=0.0.0.0
ENV PORT=9000

CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "9000"]
