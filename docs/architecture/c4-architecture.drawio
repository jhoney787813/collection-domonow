        <mxCell id="c_ev_assigned" value="&lt;b&gt;SpotAssignedDomainEventHandler&lt;/b&gt;&lt;br&gt;1. Invalida cache Redis de cupos disponibles.&lt;br&gt;2. Actualiza proyección de visitas del día en modelo de lectura.&lt;br&gt;3. Emite notificación al bus para el microfrontend de analítica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1020" y="1060" width="510" height="85" as="geometry" />
