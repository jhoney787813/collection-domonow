        <mxCell id="c_q_hnd" value="&lt;b&gt;GetParkingSpotsQueryHandler&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#0284C7;&quot;&gt;Lectura Directa (Dapper / Read-Only Context)&lt;/b&gt;&lt;br&gt;Omite tracking de entidades y valida primero en Redis Cache (&amp;lt; 2ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;align=center;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1010" y="815" width="500" height="75" as="geometry" />
