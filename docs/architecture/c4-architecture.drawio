        <!-- Titulo y Metadatos C4 -->
        <mxCell id="title_block_l2" value="&lt;b style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;DomoNow Visitor Parking Subsystem - Diagrama de Contenedores (C4 Nivel 2)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Descomposición en contenedores ejecutables: Microfrontends (Single-SPA), Backend CQRS (.NET 10 LTS) y Persistencia (PostgreSQL 17)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1250" height="50" as="geometry" />
