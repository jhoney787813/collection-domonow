        <mxCell id="box_domain_handlers" value="Manejadores de Eventos de Dominio (Actualización de Proyecciones de Lectura &amp; Cache)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
