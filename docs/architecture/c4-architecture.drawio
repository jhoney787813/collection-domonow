        <mxCell id="c_chk_agg" value="&lt;b&gt;Agregado: ParkingAssignment&lt;/b&gt;&lt;br&gt;Invariante: ExitDate &amp;gt;= EntryDate, Status -&amp;gt; Completed&lt;br&gt;Genera: SpotReleasedDomainEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6C35DE;align=center;" vertex="1" parent="1">
