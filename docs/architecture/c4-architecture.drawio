          <mxGeometry x="60" y="100" width="840" height="1220" as="geometry" />
        </mxCell>

        <!-- 1.1 Root Config Components -->
        <mxCell id="box_root_components" value="Contenedor 1: Root Shell Orchestrator (:9000)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#1E40AF;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="140" width="780" height="230" as="geometry" />
        </mxCell>

        <mxCell id="c_auth" value="&lt;b&gt;AuthController&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[TypeScript / HTML5]&lt;/span&gt;&lt;br&gt;Gestión de sesión en localStorage, credenciales estáticas de portería, autocompletado demo y logout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="110" y="180" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c_router" value="&lt;b&gt;SingleSpaRouter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[Single-SPA Core]&lt;/span&gt;&lt;br&gt;Guarda rutas activas según autenticación, gestiona activeWhen y monta/desmonta contenedores iframes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="180" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c_i18n_root" value="&lt;b&gt;I18nCoordinator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[CustomEvent / postMessage]&lt;/span&gt;&lt;br&gt;Conmutador reactivo ESP/ENG, actualiza barra institucional y transmite eventos a los MFEs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="630" y="180" width="220" height="90" as="geometry" />
