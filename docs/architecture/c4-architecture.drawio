        <mxCell id="1" parent="0" />

        <!-- Titulo -->
        <mxCell id="title_block" value="&lt;b style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;DomoNow PropTech Platform - Diagrama de Componentes (C4 Nivel 3)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Desglose de Microfrontends (Frontend) y Vertical Slice Architecture con CQRS (Backend .NET 10)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1100" height="50" as="geometry" />
