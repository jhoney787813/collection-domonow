  <diagram id="c4-context-diagram" name="C4 Nivel 1 - Contexto del Sistema">
    <mxGraphModel dx="1422" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" background="#F8FAFC" math="0" shadow="0">
      <root>
