        <mxCell id="tab_assign_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;parking_assignments&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Tabla Relacional PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; color: #0F172A;&quot;&gt;id (UUID PK), parking_spot_id (FK), license_plate, visitor_name, destination_unit, entry_time, exit_time, status (1,2)&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1390" y="780" width="420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="idx_active_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;uq_parking_active_assignment&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Restricción de Exclusión Física / Índice Único]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A;&quot;&gt;CREATE UNIQUE INDEX uq_parking_active_assignment ON parking_assignments (parking_spot_id) WHERE status = 1;&lt;br&gt;Garantiza matemáticamente que solo exista 1 asignación activa por cupo (Req 5).&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1840" y="780" width="380" height="120" as="geometry" />
        </mxCell>

        <!-- Conexiones Cross MFE - API -->
        <mxCell id="rel_fe_be_entry_l3" value="&lt;b&gt;POST /api/parking-assignments &amp;amp; checkout&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;[HTTPS / REST JSON (Req 2, 3, 5)]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#707070;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#0F172A;fontSize=10;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_ang_service_l3" target="c_assign_ctrl_l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_fe_be_spots_l3" value="&lt;b&gt;GET /api/parking-spots?statusFilter=...&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;[HTTPS / REST JSON (Req 1)]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#707070;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#0F172A;fontSize=10;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_ang_service_l3" target="c_spots_ctrl_l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_vue_be_active_l3" value="&lt;b&gt;GET /api/parking-assignments/active&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;[HTTPS / REST JSON (Req 4)]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#707070;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#0F172A;fontSize=10;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_vue_store_l3" target="c_assign_ctrl_l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_ef_db_l3" value="&lt;b&gt;Sentencias SQL parametrizadas &amp;amp; xmin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;[TCP 5432 / Npgsql EF Core 10]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#707070;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#0F172A;fontSize=10;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_ef_dbcontext_l3" target="tab_assign_l3">
          <mxGeometry relative="1" as="geometry" />
