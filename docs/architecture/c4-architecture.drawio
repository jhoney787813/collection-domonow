        <mxCell id="c_q_dto" value="&lt;b&gt;ParkingSpotReadModel / DTO&lt;/b&gt;&lt;br&gt;Id, SpotNumber, Status, CurrentPlate, EntryTime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=center;" vertex="1" parent="1">
