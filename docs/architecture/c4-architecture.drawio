        <!-- CAJA DE TRAZABILIDAD DE REQUERIMIENTOS OPENSPEC -->
        <mxCell id="box_spec_trace_l1" value="&lt;b style=&quot;font-size: 12px; color: #1E293B;&quot;&gt;Trazabilidad de Requerimientos OpenSpec (spec.md):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; line-height: 1.5; color: #334155;&quot;&gt;• &lt;b&gt;Req 1:&lt;/b&gt; Spot Retrieval &amp;amp; Status Filtering (GET /api/parking-spots?statusFilter=...)&lt;br&gt;• &lt;b&gt;Req 2:&lt;/b&gt; Visitor Parking Entry Registration (POST /api/parking-assignments, regex ^[A-Z0-9]{5,8}$)&lt;br&gt;• &lt;b&gt;Req 3:&lt;/b&gt; Parking Spot Checkout &amp;amp; Status Reversion (POST /api/parking-assignments/{id}/checkout, ExitTime &amp;gt;= EntryTime)&lt;br&gt;• &lt;b&gt;Req 4:&lt;/b&gt; Active Assignments Summary Query (GET /api/parking-assignments/active)&lt;br&gt;• &lt;b&gt;Req 5:&lt;/b&gt; High-Concurrency Allocation Control (10 peticiones concurrentes a P-15 -&amp;gt; 1 HTTP 201 Created, 9 HTTP 409 Conflict)&lt;/span&gt;" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#C084FC;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=15;" vertex="1" parent="1">
          <mxGeometry x="580" y="690" width="580" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
