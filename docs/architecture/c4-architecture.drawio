        <mxCell id="leg_person_l1" value="&lt;b&gt;Persona&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Usuario o actor humano&lt;/span&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
