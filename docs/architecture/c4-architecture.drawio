        <mxCell id="c_chk_hnd" value="&lt;b&gt;CompleteParkingCheckoutCommandHandler&lt;/b&gt;&lt;br&gt;Cálculo de minutos de estadía, verificación de cobro, actualización de estado a Available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6C35DE;strokeColor=#4A1E9E;fontColor=#FFFFFF;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1590" y="415" width="500" height="70" as="geometry" />
