        <!-- ACTORES C4 (PERSON) -->
        <mxCell id="act_guard_l2" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;Guardia de Garita&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #CBD5E1;&quot;&gt;[Persona]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; color: #F8FAFC;&quot;&gt;Opera terminal vehicular en portería&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
