        <mxCell id="slice_query_spots" value="&lt;b&gt;[Vertical Slice: GetParkingSpotsQuery]&lt;/b&gt;&lt;br&gt;Caso de Uso: Consulta de Grilla de Cupos (Lectura de Alta Frecuencia)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;fontStyle=0;fontSize=12;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
