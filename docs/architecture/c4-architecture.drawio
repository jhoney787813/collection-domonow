        <mxCell id="slice_query_ml" value="&lt;b&gt;[Vertical Slice: GetDemandForecastQuery]&lt;/b&gt;&lt;br&gt;Caso de Uso: Matriz de Demanda 24x7 y Proyección de Picos ML (Lectura Analítica)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontStyle=0;fontSize=12;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
