        <mxCell id="c_ev_released" value="&lt;b&gt;SpotReleasedDomainEventHandler&lt;/b&gt;&lt;br&gt;1. Invalida cache Redis de cupos.&lt;br&gt;2. Recalcula tiempo promedio de estadía (turnaround minutes).&lt;br&gt;3. Genera registro de auditoría y cobro por fracción." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1570" y="1060" width="510" height="85" as="geometry" />
