        <!-- LIMITE DEL SISTEMA (C4 SYSTEM BOUNDARY) -->
        <mxCell id="group_domonow_l2" value="DomoNow Visitor Parking Subsystem [Límite de Sistema]" style="shape=mxgraph.c4.systemBoundary;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#475569;strokeWidth=1.5;fontColor=#1E293B;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="270" y="100" width="1470" height="970" as="geometry" />
        </mxCell>

        <!-- Contenedores Frontend -->
        <mxCell id="mfe_root_l2" value="&lt;div style=&quot;font-weight: bold; font-size: 15px; margin-bottom: 2px;&quot;&gt;Root Shell Orchestrator&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #CBD5E1;&quot;&gt;[Contenedor: Single-SPA / TypeScript]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.4; color: #F8FAFC; text-align: left; padding: 0 10px;&quot;&gt;• Login institucional estático (guardia@domonow.io) y botón de cierre de sesión (#btn-logout)&lt;br&gt;• Orquestación condicional de microfrontends con Single-SPA (activeWhen)&lt;br&gt;• Selector reactivo bilingüe [ 🇪🇸 ESP | 🇺🇸 ENG ] y cabecera con logo oficial (domonow-logo-320.webp)&lt;br&gt;• Puerto: 9000&lt;/div&gt;" style="shape=mxgraph.c4.container2;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="310" y="160" width="520" height="190" as="geometry" />
        </mxCell>

        <mxCell id="mfe_angular_l2" value="&lt;div style=&quot;font-weight: bold; font-size: 15px; margin-bottom: 2px;&quot;&gt;Operaciones de Garita MFE&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #CBD5E1;&quot;&gt;[Contenedor: Angular 19 Standalone Signals]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.4; color: #F8FAFC; text-align: left; padding: 0 10px;&quot;&gt;• Grilla de 30 cupos (P-01 a P-30) con filtros de disponibilidad (Req 1)&lt;br&gt;• Modal de registro con máscara regex de placa ^[A-Z0-9]{5,8}$ (Req 2)&lt;br&gt;• Modal de checkout con cómputo de duración y reversión de cupo a libre (Req 3)&lt;br&gt;• Simulador de ráfagas concurrentes anti-carreras sobre P-15 (Req 5)&lt;br&gt;• Puerto: 9001 (/parking)&lt;/div&gt;" style="shape=mxgraph.c4.container2;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="310" y="390" width="520" height="200" as="geometry" />
        </mxCell>

        <mxCell id="mfe_vue_l2" value="&lt;div style=&quot;font-weight: bold; font-size: 15px; margin-bottom: 2px;&quot;&gt;Analítica y Monitoreo MFE&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #CBD5E1;&quot;&gt;[Contenedor: Vue 3 Composition API &amp;amp; Pinia]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.4; color: #F8FAFC; text-align: left; padding: 0 10px;&quot;&gt;• Resumen de asignaciones activas con tiempos transcurridos (Req 4)&lt;br&gt;• Matriz de demanda semanal 24x7 (Heatmap) y KPIs de visitas y rotación&lt;br&gt;• Curva horaria estimada de demanda y feed de actividad en tiempo real sincronizado&lt;br&gt;• Puerto: 9002 (/analytics)&lt;/div&gt;" style="shape=mxgraph.c4.container2;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="310" y="630" width="520" height="190" as="geometry" />
        </mxCell>

        <mxCell id="pkg_tokens_l2" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 2px;&quot;&gt;@domonow/ui-tokens&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Contenedor: Librería Compartida / NPM]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.4; color: #1E293B; text-align: left; padding: 0 10px;&quot;&gt;Tokens de diseño institucional (#6C35DE, tipografía Plus Jakarta Sans), interfaces TypeScript compartidas y diccionarios centralizados de internacionalización (i18n).&lt;/div&gt;" style="shape=mxgraph.c4.container2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="860" width="520" height="120" as="geometry" />
        </mxCell>

        <!-- Contenedores Backend -->
        <mxCell id="api_backend_l2" value="&lt;div style=&quot;font-weight: bold; font-size: 16px; margin-bottom: 2px;&quot;&gt;DomoNow Parking API&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #CBD5E1;&quot;&gt;[Contenedor: .NET 10 LTS ASP.NET Core]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.5; color: #F8FAFC; text-align: left; padding: 0 15px;&quot;&gt;• &lt;b&gt;Arquitectura:&lt;/b&gt; Vertical Slice Architecture + CQRS con MediatR&lt;br&gt;• &lt;b&gt;Endpoints REST Implementados:&lt;/b&gt;&lt;br&gt;  - GET /api/parking-spots (Req 1: Consulta y filtro de 30 cupos)&lt;br&gt;  - POST /api/parking-assignments (Req 2 &amp;amp; 5: Registro con placa sanitizada)&lt;br&gt;  - POST /api/parking-assignments/{id}/checkout (Req 3: Salida y cálculo temporal)&lt;br&gt;  - GET /api/parking-assignments/active (Req 4: Resumen de vehículos en garita)&lt;br&gt;• &lt;b&gt;Pipeline:&lt;/b&gt; FluentValidation y ExceptionHandlingMiddleware (400, 404, 409, 422)&lt;br&gt;• Puerto: 5050&lt;/div&gt;" style="shape=mxgraph.c4.container2;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="960" y="160" width="730" height="340" as="geometry" />
        </mxCell>

        <mxCell id="db_postgres_l2" value="&lt;div style=&quot;font-weight: bold; font-size: 16px; margin-bottom: 2px;&quot;&gt;Base de Datos Relacional&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #CBD5E1;&quot;&gt;[Contenedor: Base de Datos Relacional / PostgreSQL 17 Alpine]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.5; color: #F8FAFC; text-align: left; padding: 0 15px;&quot;&gt;• &lt;b&gt;parking_spots:&lt;/b&gt; 30 cupos comunales (P-01 a P-30) con token de concurrencia xmin&lt;br&gt;• &lt;b&gt;parking_assignments:&lt;/b&gt; Historial y asignaciones activas de vehículos&lt;br&gt;• &lt;b&gt;Restricción Invariante Física de Exclusión (Req 2 &amp;amp; 5):&lt;/b&gt;&lt;br&gt;  &lt;code&gt;CREATE UNIQUE INDEX uq_parking_active_assignment&lt;br&gt;  ON parking_assignments (parking_spot_id) WHERE status = 1;&lt;/code&gt;&lt;br&gt;• Puerto: 5432&lt;/div&gt;" style="shape=mxgraph.c4.database;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=20;" vertex="1" parent="1">
          <mxGeometry x="960" y="580" width="730" height="300" as="geometry" />
        </mxCell>

        <!-- Conectores C4 -->
        <mxCell id="rel_act_root_guard_l2" value="&lt;b&gt;Accede a login y opera garita&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[HTTPS :9000]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.45;entryDx=0;entryDy=0;strokeColor=#707070;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#0F172A;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="act_guard_l2" target="mfe_root_l2">
          <mxGeometry relative="1" as="geometry" />
