<mxfile host="Electron" modified="2026-09-12T19:20:00.000Z" agent="DomoNow Architecture Team" version="21.6.8" type="device">
  <diagram id="c4-context-diagram" name="C4 Nivel 1 - Contexto del Sistema">
    <mxGraphModel dx="1422" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Titulo y Metadatos -->
        <mxCell id="title_block" value="&lt;b style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;DomoNow PropTech Platform - Diagrama de Contexto del Sistema (C4 Nivel 1)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Modelo de Arquitectura para el Ecosistema de Gestión de Portería, Visitas y Parqueaderos&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="850" height="50" as="geometry" />
        </mxCell>

        <!-- ACTORES / PERSONAS -->
        <!-- 1. Guardia de Porteria -->
        <mxCell id="actor_guard" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Persona]&lt;br&gt;Guardia de Portería&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Personal de seguridad y control en garita principal. Registra entradas, salidas y autorizaciones vehiculares.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- 2. Residente / Copropietario -->
        <mxCell id="actor_resident" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Persona]&lt;br&gt;Residente / Propietario&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Habitante de la copropiedad. Pre-autoriza visitantes, consulta disponibilidad y recibe notificaciones.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- 3. Administrador de la Copropiedad -->
        <mxCell id="actor_admin" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Persona]&lt;br&gt;Administrador de Copropiedad&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Gestiona políticas de cobro, auditoría de ocupación, reportes analíticos y tarifas de parqueadero.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- 4. Visitante Vehicular -->
        <mxCell id="actor_visitor" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Persona]&lt;br&gt;Visitante Vehicular&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Conductor que ingresa al conjunto a visitar una unidad residencial temporalmente.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="810" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- SISTEMA CENTRAL: DOMONOW PLATFORM -->
        <mxCell id="system_domonow" value="&lt;div style=&quot;font-weight: bold; font-size: 18px; margin-bottom: 8px;&quot;&gt;[Sistema de Software]&lt;br&gt;DomoNow PropTech Platform&lt;/div&gt;&lt;div style=&quot;font-size: 12px; line-height: 1.5; color: #F1F5F9;&quot;&gt;Plataforma integral de control de acceso vehicular, administración de parqueaderos comunales, asignación concurrente en tiempo real, predicción de saturación con Machine Learning y liquidación tarifaria.&lt;br&gt;&lt;br&gt;&lt;b&gt;Arquitectura:&lt;/b&gt; Microfrontends (Single-SPA, Angular 19, Vue 3) + Backend CQRS con Vertical Slice Architecture (.NET 10).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="340" width="380" height="340" as="geometry" />
        </mxCell>

        <!-- SISTEMAS EXTERNOS -->
        <!-- 1. Sistema LPR Camaras -->
        <mxCell id="ext_lpr" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Sistema Externo]&lt;br&gt;Cámaras LPR &amp; Sensores IoT&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Reconocimiento automático de placas vehiculares en carril de desaceleración.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="190" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- 2. Talanqueras y Barreras IoT -->
        <mxCell id="ext_gates" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Sistema Externo]&lt;br&gt;Barreras Vehiculares IoT&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Controladores físicos de apertura y cierre de talanqueras por relé / protocolo MQTT.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="380" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- 3. Pasarela de Notificaciones -->
        <mxCell id="ext_notifications" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Sistema Externo]&lt;br&gt;Pasarela de Mensajería&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;WhatsApp Cloud API, SMS y Notificaciones Push (Firebase Cloud Messaging).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="570" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- 4. Pasarela de Pagos -->
        <mxCell id="ext_payments" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Sistema Externo]&lt;br&gt;Pasarela de Pagos (Wompi / PSE)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Procesamiento de pagos electrónicos por fracciones de estacionamiento de visitantes.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="760" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- RELACIONES / CONEXIONES -->
        <!-- Guardia -> DomoNow -->
        <mxCell id="rel_guard" value="Opera asignaciones en vivo,&lt;br&gt;gestiona checkout y resuelve carreras&lt;br&gt;&lt;b&gt;[HTTPS / WebSockets]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;fontColor=#0F172A;" edge="1" parent="1" source="actor_guard" target="system_domonow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Residente -> DomoNow -->
        <mxCell id="rel_resident" value="Pre-autoriza placas y&lt;br&gt;consulta cupos disponibles&lt;br&gt;&lt;b&gt;[HTTPS / REST]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.45;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;fontColor=#0F172A;" edge="1" parent="1" source="actor_resident" target="system_domonow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Admin -> DomoNow -->
        <mxCell id="rel_admin" value="Consulta analítica predictiva,&lt;br&gt;audita ocupación y configura tarifas&lt;br&gt;&lt;b&gt;[HTTPS]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;fontColor=#0F172A;" edge="1" parent="1" source="actor_admin" target="system_domonow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Visitante -> DomoNow -->
        <mxCell id="rel_visitor" value="Paga fracción de parqueadero&lt;br&gt;vía QR de portería&lt;br&gt;&lt;b&gt;[Web Responsive / HTTPS]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.9;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;fontColor=#0F172A;" edge="1" parent="1" source="actor_visitor" target="system_domonow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DomoNow -> LPR -->
        <mxCell id="rel_lpr" value="Recibe evento de placa detectada&lt;br&gt;&lt;b&gt;[Webhook / MQTT]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#0F172A;" edge="1" parent="1" source="system_domonow" target="ext_lpr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DomoNow -> Talanqueras -->
        <mxCell id="rel_gates" value="Ordena apertura al asignar cupo&lt;br&gt;&lt;b&gt;[MQTT / Relay API]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#0F172A;" edge="1" parent="1" source="system_domonow" target="ext_gates">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DomoNow -> Notificaciones -->
        <mxCell id="rel_notif" value="Envía aviso de llegada al residente&lt;br&gt;&lt;b&gt;[REST / HTTPS]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#0F172A;" edge="1" parent="1" source="system_domonow" target="ext_notifications">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DomoNow -> Pagos -->
        <mxCell id="rel_pay" value="Genera cobro por estadía vehicular&lt;br&gt;&lt;b&gt;[REST / Webhooks]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#0F172A;" edge="1" parent="1" source="system_domonow" target="ext_payments">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c4-containers-diagram" name="C4 Nivel 2 - Diagrama de Contenedores">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titulo -->
        <mxCell id="title_block" value="&lt;b style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;DomoNow PropTech Platform - Diagrama de Contenedores (C4 Nivel 2)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Desacoplamiento de Microfrontends (Single-SPA) y Backend CQRS con Vertical Slice Architecture&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="950" height="50" as="geometry" />
        </mxCell>

        <!-- ACTORES -->
        <mxCell id="act_guard" value="&lt;div style=&quot;font-weight: bold; font-size: 13px;&quot;&gt;Guardia de Portería&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #E2E8F0;&quot;&gt;Navegador Web Desktop&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="160" height="130" as="geometry" />
        </mxCell>

        <mxCell id="act_admin" value="&lt;div style=&quot;font-weight: bold; font-size: 13px;&quot;&gt;Administrador / Auditor&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #E2E8F0;&quot;&gt;Navegador Web / Tablet&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="160" height="130" as="geometry" />
        </mxCell>

        <!-- LIMITE DEL SISTEMA: DOMONOW PLATFORM -->
        <mxCell id="group_domonow" value="DomoNow PropTech Platform - Límite de la Solución" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=2;dashed=1;fontStyle=1;fontSize=14;fontColor=#475569;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="270" y="100" width="1460" height="1120" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- SUB-SISTEMA 1: FRONTEND MICROFRONTENDS     -->
        <!-- ========================================== -->
        <mxCell id="group_frontend" value="Cluster Frontend Microfrontends (Browser Runtime)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="560" height="1040" as="geometry" />
        </mxCell>

        <!-- Contenedor 1: Root Shell Orchestrator -->
        <mxCell id="mfe_root" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Contenedor: Web App]&lt;br&gt;Root Orchestrator (Single-SPA)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; Vite, TypeScript, Single-SPA Core, HTML5/CSS3&lt;br&gt;&lt;b&gt;Puerto:&lt;/b&gt; 9000&lt;br&gt;&lt;br&gt;Gestiona la pantalla inicial de Login estático, sesión en localStorage, navbar institucional, conmutación bilingüe ESP/ENG y orquestación de ciclo de vida de microfrontends.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="190" width="500" height="170" as="geometry" />
        </mxCell>

        <!-- Contenedor 2: Angular 19 Parking Operations MFE -->
        <mxCell id="mfe_angular" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Contenedor: Microfrontend]&lt;br&gt;Operaciones de Parqueadero&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; Angular 19, TypeScript, Angular Signals, RxJS&lt;br&gt;&lt;b&gt;Puerto:&lt;/b&gt; 9001 (/parking)&lt;br&gt;&lt;br&gt;Tablero de control en tiempo real para portería: grilla reactiva de 30 cupos, modales de ingreso/salida, normalización de placas y simulación de ráfaga concurrente anti-carreras.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD0031;strokeColor=#A60024;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="500" height="170" as="geometry" />
        </mxCell>

        <!-- Contenedor 3: Vue 3 Analytics & Demand MFE -->
        <mxCell id="mfe_vue" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Contenedor: Microfrontend]&lt;br&gt;Analítica Predictiva &amp; Demanda&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; Vue 3, Vite, Pinia, ONNX Runtime Web&lt;br&gt;&lt;b&gt;Puerto:&lt;/b&gt; 9002 (/analytics)&lt;br&gt;&lt;br&gt;Panel de inteligencia operativa: matriz de calor de demanda 24x7, curva horaria estimada, inferencia ML de saturación inminente y feed reactivo de eventos inter-MFE.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#41B883;strokeColor=#2F855E;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="650" width="500" height="170" as="geometry" />
        </mxCell>

        <!-- Contenedor 4: Shared UI Tokens Package -->
        <mxCell id="pkg_tokens" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 4px;&quot;&gt;[Librería de Componentes &amp; Tokens]&lt;br&gt;@domonow/ui-tokens&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #4A1E9E;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; CSS Tokens, TypeScript Shared Types, i18n Dictionaries&lt;br&gt;Garantiza coherencia visual institucional (Paleta #6C35DE, Plus Jakarta Sans, Spacing tokens).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#C084FC;strokeWidth=2;fontColor=#4A1E9E;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="880" width="500" height="110" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- SUB-SISTEMA 2: BACKEND CQRS & SLICES       -->
        <!-- ========================================== -->
        <mxCell id="group_backend" value="Cluster Backend (.NET 10 LTS &amp; Persistencia)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="140" width="770" height="1040" as="geometry" />
        </mxCell>

        <!-- Backend API Gateway -->
        <mxCell id="api_backend" value="&lt;div style=&quot;font-weight: bold; font-size: 16px; margin-bottom: 6px;&quot;&gt;[Contenedor: Backend Web API]&lt;br&gt;DomoNow Parking API (.NET 10)&lt;/div&gt;&lt;div style=&quot;font-size: 12px; line-height: 1.5; color: #F8FAFC;&quot;&gt;&lt;b&gt;Arquitectura:&lt;/b&gt; Vertical Slice Architecture + CQRS + MediatR&lt;br&gt;&lt;b&gt;Framework:&lt;/b&gt; ASP.NET Core Minimal APIs, C# 14, FluentValidation&lt;br&gt;&lt;br&gt;Cada caso de uso está encapsulado en un slice independiente (Comandos y Consultas segregadas). Procesa transacciones concurrentes con control optimista (RowVersion / xmin) y expone contratos RESTful / OpenAPI.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#512BD4;strokeColor=#3A1C9E;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="240" width="690" height="230" as="geometry" />
        </mxCell>

        <!-- Base de Datos: PostgreSQL 16 -->
        <mxCell id="db_postgres" value="&lt;div style=&quot;font-weight: bold; font-size: 15px; margin-bottom: 4px;&quot;&gt;[Base de Datos Relacional]&lt;br&gt;PostgreSQL 16 Engine&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Write &amp; Read Store:&lt;/b&gt;&lt;br&gt;- parking_spots (Cupos 1..30)&lt;br&gt;- parking_assignments (Historial de estancias)&lt;br&gt;- audit_logs (Trazabilidad y seguridad)&lt;br&gt;&lt;br&gt;&lt;b&gt;Restricción Invariante Física:&lt;/b&gt;&lt;br&gt;uq_parking_active_assignment (Garantía física anti-colisión)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#2D72D9;strokeColor=#1C4E96;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="550" width="310" height="260" as="geometry" />
        </mxCell>

        <!-- Cache Distribuido: Redis -->
        <mxCell id="cache_redis" value="&lt;div style=&quot;font-weight: bold; font-size: 15px; margin-bottom: 4px;&quot;&gt;[Cache en Memoria]&lt;br&gt;Redis Distributed Cache&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Snapshot de disponibilidad de cupos en tiempo real y resultados de consultas de alta frecuencia.&lt;br&gt;&lt;br&gt;&lt;b&gt;Latencia:&lt;/b&gt; &amp;lt; 2 ms&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DC2626;strokeColor=#991B1B;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="550" width="310" height="260" as="geometry" />
        </mxCell>

        <!-- Broker de Mensajeria Asincrona -->
        <mxCell id="bus_events" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Broker de Mensajería / Bus de Eventos]&lt;br&gt;RabbitMQ / Internal MediatR Events&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;Desacopla la publicación de eventos de dominio (SpotAssignedEvent, SpotReleasedEvent) hacia analítica y notificaciones externas.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FED7AA;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="880" width="690" height="110" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- RELACIONES ENTRE CONTENEDORES              -->
        <!-- ========================================== -->
        <!-- Actores -> Root Orchestrator -->
        <mxCell id="rel_act_root" value="Accede al Login y Shell&lt;br&gt;&lt;b&gt;[HTTPS:9000]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.35;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;" edge="1" parent="1" source="act_guard" target="mfe_root">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_act_admin" value="Accede a Métricas&lt;br&gt;&lt;b&gt;[HTTPS:9000]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;" edge="1" parent="1" source="act_admin" target="mfe_root">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Root -> Angular MFE -->
        <mxCell id="rel_root_ang" value="Monta bajo /parking en iframe / in-memory&lt;br&gt;&lt;b&gt;[postMessage / CustomEvents]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6C35DE;strokeWidth=2;fontColor=#4A1E9E;" edge="1" parent="1" source="mfe_root" target="mfe_angular">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Root -> Vue MFE -->
        <mxCell id="rel_root_vue" value="Monta bajo /analytics&lt;br&gt;&lt;b&gt;[postMessage / Sincronización de Idioma]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6C35DE;strokeWidth=2;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;fontColor=#4A1E9E;" edge="1" parent="1" source="mfe_root" target="mfe_vue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Tokens -> MFEs -->
        <mxCell id="rel_tokens_ang" value="Aplica tokens de diseño" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;strokeColor=#C084FC;" edge="1" parent="1" source="pkg_tokens" target="mfe_vue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Angular MFE -> Backend API -->
        <mxCell id="rel_ang_api" value="Ejecuta Comandos (RegisterEntry, Checkout)&lt;br&gt;&lt;b&gt;[REST / JSON - HTTP POST]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;strokeColor=#512BD4;strokeWidth=2;fontColor=#1E293B;" edge="1" parent="1" source="mfe_angular" target="api_backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Vue MFE -> Backend API -->
        <mxCell id="rel_vue_api" value="Ejecuta Consultas (Demanda, Ocupación Histórica)&lt;br&gt;&lt;b&gt;[REST / JSON - HTTP GET]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;strokeColor=#512BD4;strokeWidth=2;fontColor=#1E293B;" edge="1" parent="1" source="mfe_vue" target="api_backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend API -> PostgreSQL -->
        <mxCell id="rel_api_db" value="Comandos de Escritura (EF Core 10)&lt;br&gt;Transacciones y Control Concurrente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2D72D9;strokeWidth=2;" edge="1" parent="1" source="api_backend" target="db_postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend API -> Redis -->
        <mxCell id="rel_api_cache" value="Consultas Rápidas (Dapper / ReadOnly)&lt;br&gt;Invalidación por escritura" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#DC2626;strokeWidth=2;" edge="1" parent="1" source="api_backend" target="cache_redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend API -> Event Bus -->
        <mxCell id="rel_api_bus" value="Publica Eventos de Dominio Asíncronos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#F97316;strokeWidth=2;dashed=1;" edge="1" parent="1" source="db_postgres" target="bus_events">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c4-components-diagram" name="C4 Nivel 3 - Diagrama de Componentes">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" background="#F8FAFC" math="0" shadow="0">
      <root>
