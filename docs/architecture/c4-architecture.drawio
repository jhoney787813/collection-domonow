        <!-- Titulo y Metadatos C4 -->
        <mxCell id="title_block_l1" value="&lt;b style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;DomoNow Visitor Parking Subsystem - Diagrama de Contexto (C4 Nivel 1)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Especificación oficial de límites del sistema, actores humanos y relaciones externas (open-spec/specs/visitor-parking/spec.md)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="35" width="1050" height="50" as="geometry" />
        </mxCell>

        <!-- ACTORES C4 OFICIALES (PERSON) -->
        <mxCell id="actor_guard" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 2px;&quot;&gt;Guardia de Portería / Operador&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #CBD5E1;&quot;&gt;[Persona]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.4; color: #F8FAFC;&quot;&gt;Operador del puesto de control en garita. Registra ingresos vehiculares con placa normalizada, procesa salidas (checkouts) y consulta disponibilidad de cupos en tiempo real.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="260" height="180" as="geometry" />
        </mxCell>

        <mxCell id="actor_admin" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 2px;&quot;&gt;Administrador / Supervisor&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #CBD5E1;&quot;&gt;[Persona]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.4; color: #F8FAFC;&quot;&gt;Supervisor de la copropiedad. Monitorea el resumen de asignaciones activas, la rotación de cupos y las matrices analíticas de demanda semanal 24x7.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="470" width="260" height="180" as="geometry" />
        </mxCell>

        <!-- SISTEMA DE SOFTWARE C4 (SOFTWARE SYSTEM) -->
        <mxCell id="system_domonow" value="&lt;div style=&quot;font-weight: bold; font-size: 18px; margin-bottom: 4px;&quot;&gt;DomoNow Visitor Parking Subsystem&lt;/div&gt;&lt;div style=&quot;font-size: 12px; color: #CBD5E1;&quot;&gt;[Sistema de Software]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 12px; line-height: 1.6; color: #F8FAFC; text-align: left; padding: 0 20px;&quot;&gt;Subsistema de software para control de parqueadero de visitantes en copropiedades:&lt;br&gt;• &lt;b&gt;Consulta y filtrado de 30 cupos comunales (P-01 a P-30)&lt;/b&gt; (Req 1)&lt;br&gt;• &lt;b&gt;Registro de ingreso con normalización regex de placa&lt;/b&gt; (^[A-Z0-9]{5,8}$) (Req 2)&lt;br&gt;• &lt;b&gt;Salida y reversión de cupo con validación de invariante temporal&lt;/b&gt; (ExitTime &amp;gt;= EntryTime) (Req 3)&lt;br&gt;• &lt;b&gt;Resumen en tiempo real de asignaciones activas y tiempos transcurridos&lt;/b&gt; (Req 4)&lt;br&gt;• &lt;b&gt;Defensa estricta de concurrencia optimista (xmin) y exclusión física&lt;/b&gt; (uq_parking_active_assignment) (Req 5)&lt;/div&gt;" style="shape=mxgraph.c4.softwareSystem;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=20;" vertex="1" parent="1">
          <mxGeometry x="580" y="210" width="580" height="440" as="geometry" />
        </mxCell>

        <!-- CONECTORES C4 OFICIALES (RELATIONSHIPS) -->
        <mxCell id="rel_guard" value="&lt;b&gt;Registra ingresos, realiza checkouts y consulta cupos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[HTTPS / Web Browser]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#707070;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="actor_guard" target="system_domonow">
          <mxGeometry relative="1" as="geometry" />
