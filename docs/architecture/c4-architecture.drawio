  <!-- ========================================================================= -->
  <!-- PESTAÑA 3: C4 NIVEL 3 - DIAGRAMA DE COMPONENTES                           -->
  <!-- ========================================================================= -->
  <diagram id="c4-components-diagram" name="C4 Nivel 3 - Diagrama de Componentes">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1450" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titulo y Metadatos C4 -->
        <mxCell id="title_block_l3" value="&lt;b style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;DomoNow Visitor Parking Subsystem - Diagrama de Componentes (C4 Nivel 3)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Estructura interna de componentes: MFE Garita (Angular 19), MFE Analítica (Vue 3), Vertical Slices CQRS (.NET 10 LTS) y Persistencia (PostgreSQL 17)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="1450" height="50" as="geometry" />
        </mxCell>

        <!-- LIMITE DE CONTENEDOR 1: ANGULAR 19 OPERATIONS MFE -->
        <mxCell id="bound_angular_l3" value="Operaciones de Garita MFE [Límite de Contenedor: Angular 19 Signals :9001]" style="shape=mxgraph.c4.containerBoundary;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#475569;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="800" height="420" as="geometry" />
        </mxCell>

        <mxCell id="c_ang_grid_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;ParkingGridComponent&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: Angular Standalone]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A;&quot;&gt;Grilla interactiva de 30 cupos (P-01 a P-30) con filtros reactivos por statusFilter: Todos, Disponibles, Ocupados y Fuera de Servicio (Req 1).&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="230" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_ang_modals_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;EntryCheckoutModalsComponent&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: Angular Standalone]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A;&quot;&gt;Modales reactivos de registro vehicular con sanitización de placa (regex ^[A-Z0-9]{5,8}$) y checkout con cómputo de duración (Req 2 &amp;amp; 3).&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="240" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_ang_sim_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;ConcurrencySimulatorComponent&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: Angular Standalone]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A;&quot;&gt;Simulador de 10 peticiones concurrentes a P-15 (1 éxito 201 Created y 9 rechazos 409 Conflict) (Req 5).&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="130" width="230" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_ang_service_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 2px;&quot;&gt;ParkingService&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: Angular Signal Store &amp;amp; HTTP Client]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.4; color: #0F172A;&quot;&gt;Gestiona el estado reactivo mediante Angular Signals (cupos, contadores de disponibilidad y filtros) y despacha llamadas REST HTTP hacia la API.&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="310" width="480" height="140" as="geometry" />
        </mxCell>

        <!-- LIMITE DE CONTENEDOR 2: VUE 3 ANALYTICS MFE -->
        <mxCell id="bound_vue_l3" value="Analítica y Monitoreo MFE [Límite de Contenedor: Vue 3 Composition API &amp;amp; Pinia :9002]" style="shape=mxgraph.c4.containerBoundary;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#475569;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="800" height="420" as="geometry" />
        </mxCell>

        <mxCell id="c_vue_heat_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;DemandHeatmapComponent&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: Vue 3 SFC]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A;&quot;&gt;Matriz visual 24x7 (7 días x 5 franjas horarias) con gradiente de calor sobre la ocupación comunal.&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="590" width="230" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_vue_fcst_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;PeakHourForecasterComponent&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: Vue 3 SFC / Chart]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A;&quot;&gt;Curva estimada horaria de demanda (06:00 a 22:00) y tarjeta de especificaciones ONNX Runtime Web.&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="590" width="240" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_vue_feed_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;ActivityFeedComponent&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: Vue 3 SFC]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A;&quot;&gt;Feed reactivo de eventos de asignación y checkout sincronizados en tiempo real mediante el bus inter-MFE.&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="590" width="230" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_vue_store_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 2px;&quot;&gt;AnalyticsStore&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: Pinia Store &amp;amp; HTTP Client]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.4; color: #0F172A;&quot;&gt;Almacena resumen de asignaciones activas (bahías, placas, visitantes y tiempos transcurridos) y KPIs de ocupación diaria (Req 4).&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="770" width="480" height="140" as="geometry" />
        </mxCell>

        <!-- LIMITE DE CONTENEDOR 3: BACKEND API (.NET 10 LTS) -->
        <mxCell id="bound_backend_l3" value="DomoNow Parking API [Límite de Contenedor: .NET 10 LTS ASP.NET Core :5050]" style="shape=mxgraph.c4.containerBoundary;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#475569;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="930" y="90" width="1310" height="880" as="geometry" />
        </mxCell>

        <!-- Controladores REST -->
        <mxCell id="c_spots_ctrl_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;ParkingSpotsController&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: ASP.NET Core Controller]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; color: #0F172A;&quot;&gt;GET /api/parking-spots?statusFilter=... (Req 1)&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="140" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c_assign_ctrl_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;ParkingAssignmentsController&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: ASP.NET Core Controller]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; color: #0F172A;&quot;&gt;POST /api/parking-assignments | POST checkout | GET active (Req 2, 3, 4, 5)&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="140" width="440" height="80" as="geometry" />
        </mxCell>

        <!-- Pipeline MediatR & Middleware -->
        <mxCell id="c_pipe_val_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 12px; margin-bottom: 2px;&quot;&gt;ValidationBehavior&lt;/div&gt;&lt;div style=&quot;font-size: 9px; color: #334155;&quot;&gt;[Componente: MediatR Behavior]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; color: #0F172A;&quot;&gt;Ejecuta validadores FluentValidation (placa regex, etc.)&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1790" y="140" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c_pipe_ex_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 12px; margin-bottom: 2px;&quot;&gt;ExceptionMiddleware&lt;/div&gt;&lt;div style=&quot;font-size: 9px; color: #334155;&quot;&gt;[Componente: ASP.NET Middleware]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; color: #0F172A;&quot;&gt;Mapea: Conflict-&amp;gt;409, Validation-&amp;gt;422, Domain-&amp;gt;400&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2020" y="140" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Vertical Slices Handlers -->
        <mxCell id="h_spots_query_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;GetParkingSpotsQueryHandler&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: MediatR Query Handler]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A; text-align: left; padding: 0 8px;&quot;&gt;• Implementa Caso de Uso: Consulta y Filtrado (Req 1)&lt;br&gt;• Lee 30 cupos (P-01 a P-30) con AsNoTracking()&lt;br&gt;• Incluye asignación activa si el cupo está ocupado&lt;br&gt;• Retorna HTTP 200 con List&amp;lt;ParkingSpotDto&amp;gt;&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="270" width="280" height="190" as="geometry" />
        </mxCell>

        <mxCell id="h_entry_cmd_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;RegisterParkingEntryCommandHandler&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: MediatR Command Handler]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A; text-align: left; padding: 0 8px;&quot;&gt;• Implementa Caso de Uso: Registro de Ingreso (Req 2 &amp;amp; 5)&lt;br&gt;• Sanitiza y valida placa (regex ^[A-Z0-9]{5,8}$)&lt;br&gt;• Verifica estado disponible en agregados de dominio&lt;br&gt;• Persiste en UTC y transiciona cupo a Occupied&lt;br&gt;• Retorna HTTP 201 Created&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1280" y="270" width="300" height="190" as="geometry" />
        </mxCell>

        <mxCell id="h_checkout_cmd_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;RegisterParkingCheckoutCommandHandler&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: MediatR Command Handler]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A; text-align: left; padding: 0 8px;&quot;&gt;• Implementa Caso de Uso: Salida y Reversión (Req 3)&lt;br&gt;• Valida invariante temporal (ExitTime &amp;gt;= EntryTime)&lt;br&gt;• Si ExitTime &amp;lt; EntryTime lanza DomainException (HTTP 400)&lt;br&gt;• Restaura cupo a Available y calcula minutos de estadía&lt;br&gt;• Retorna HTTP 200 OK&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1620" y="270" width="300" height="190" as="geometry" />
        </mxCell>

        <mxCell id="h_active_query_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;GetActiveAssignmentsQueryHandler&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: MediatR Query Handler]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.4; color: #0F172A; text-align: left; padding: 0 8px;&quot;&gt;• Implementa Caso de Uso: Resumen Activo (Req 4)&lt;br&gt;• Consulta asignaciones con status = 1 (Active)&lt;br&gt;• Retorna DTO con placa, visitante, unidad y minutos de estancia&lt;br&gt;• Retorna HTTP 200 con List&amp;lt;ActiveAssignmentSummaryDto&amp;gt;&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1950" y="270" width="270" height="190" as="geometry" />
        </mxCell>

        <!-- Capa 3: Dominio & Persistencia EF Core -->
        <mxCell id="c_domain_model_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 2px;&quot;&gt;Domain Model &amp;amp; Aggregates&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: C# 14 Domain Layer]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.5; color: #0F172A; text-align: left; padding: 0 15px;&quot;&gt;• &lt;b&gt;ParkingSpot (Agregado):&lt;/b&gt; Id, SpotNumber, Status, RowVersion (xmin). Métodos: AssignSpot(), ReleaseSpot(), MarkOutOfService().&lt;br&gt;• &lt;b&gt;ParkingAssignment (Agregado):&lt;/b&gt; Id, ParkingSpotId, LicensePlate, VisitorName, DestinationUnit, EntryTimeUtc, ExitTimeUtc, Status. Método: CompleteCheckout().&lt;br&gt;• &lt;b&gt;LicensePlate (Value Object):&lt;/b&gt; Normalización de placa y validación regex ^[A-Z0-9]{5,8}$.&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="520" width="620" height="160" as="geometry" />
        </mxCell>

        <mxCell id="c_ef_dbcontext_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 2px;&quot;&gt;ParkingDbContext &amp;amp; Repositories&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Componente: EF Core 10 &amp;amp; Npgsql Provider]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.5; color: #0F172A; text-align: left; padding: 0 15px;&quot;&gt;• Implementa IParkingSpotRepository y IParkingAssignmentRepository.&lt;br&gt;• Configura token de concurrencia optimista sobre columna xmin de PostgreSQL.&lt;br&gt;• Inicialización de datos de semilla (Seed Data con 30 cupos P-01 a P-30).&lt;br&gt;• Mapeo relacional fluido con Fluent API.&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1620" y="520" width="600" height="160" as="geometry" />
        </mxCell>

        <!-- Conexiones internas Backend -->
        <mxCell id="rel_ctrl_mediatr_l3" value="&lt;b&gt;Despacha Request con ISender.Send&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;[In-Process / MediatR]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#0F172A;fontSize=10;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_assign_ctrl_l3" target="h_entry_cmd_l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_hnd_domain_l3" value="&lt;b&gt;Aplica invariantes de negocio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;[In-Process C# 14]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#0F172A;fontSize=10;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="h_entry_cmd_l3" target="c_domain_model_l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_hnd_ef_l3" value="&lt;b&gt;Persiste cambios transaccionales&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;[EF Core 10 DbContext]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#0F172A;fontSize=10;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="h_entry_cmd_l3" target="c_ef_dbcontext_l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LIMITE DE CONTENEDOR 4: PERSISTENCIA POSTGRESQL 17 -->
        <mxCell id="bound_db_l3" value="Base de Datos Relacional [Límite de Contenedor: PostgreSQL 17 Alpine :5432]" style="shape=mxgraph.c4.containerBoundary;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#475569;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="930" y="730" width="1310" height="220" as="geometry" />
        </mxCell>

        <mxCell id="tab_spots_l3" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 2px;&quot;&gt;parking_spots&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #334155;&quot;&gt;[Tabla Relacional PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10px; color: #0F172A;&quot;&gt;id (UUID PK), spot_number (P-01..P-30), status (0,1,2), xmin (Concurrency Token)&lt;/div&gt;" style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="780" width="400" height="120" as="geometry" />
