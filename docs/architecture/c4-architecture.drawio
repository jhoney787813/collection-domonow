<mxfile host="65bd71144e">
    <diagram id="c4-context-diagram" name="C4 Nivel 1 - Contexto del Sistema">
        <mxGraphModel dx="1030" dy="746" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" background="#F8FAFC" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title_block" value="&lt;b style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;DomoNow Visitor Parking Subsystem - Diagrama de Contexto (C4 Nivel 1)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Alineado estrictamente a la especificación de negocio (open-spec/specs/visitor-parking/spec.md)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="40" width="950" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="actor_guard" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Persona]&lt;br&gt;Guardia de Portería / Operador&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Operador del puesto de control vehicular en garita. Registra ingresos de visitantes con placa sanitizada, realiza checkouts y consulta cupos en tiempo real.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" parent="1" vertex="1">
                    <mxGeometry x="80" y="240" width="240" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="actor_admin" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Persona]&lt;br&gt;Administrador / Supervisor&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Supervisor de la copropiedad. Monitorea el resumen de asignaciones activas, la tasa de ocupación comunal y la matriz de demanda semanal 24x7.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" parent="1" vertex="1">
                    <mxGeometry x="80" y="520" width="240" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="system_domonow" value="&lt;div style=&quot;font-weight: bold; font-size: 18px; margin-bottom: 8px;&quot;&gt;[Sistema de Software]&lt;br&gt;DomoNow Visitor Parking Subsystem&lt;/div&gt;&lt;div style=&quot;font-size: 12px; line-height: 1.5; color: #F1F5F9; text-align: left; padding: 0 10px;&quot;&gt;Subsistema de software para copropiedades residenciales que gestiona:&lt;br&gt;• &lt;b&gt;Consulta y Filtrado de 30 Cupos (P-01 a P-30):&lt;/b&gt; Estados Disponible, Ocupado y Fuera de Servicio.&lt;br&gt;• &lt;b&gt;Registro de Ingreso de Visitantes:&lt;/b&gt; Asignación de cupo, normalización de placa (regex ^[A-Z0-9]{5,8}$), registro en UTC.&lt;br&gt;• &lt;b&gt;Salida y Reversión de Cupo (Checkout):&lt;/b&gt; Verificación temporal (ExitTime &gt;= EntryTime) y restauración a Disponible.&lt;br&gt;• &lt;b&gt;Resumen de Asignaciones Activas:&lt;/b&gt; Tiempos transcurridos y unidades de destino.&lt;br&gt;• &lt;b&gt;Control de Alta Concurrencia:&lt;/b&gt; Bloqueo optimista (RowVersion / xmin) y exclusión física de sobreasignación (uq_parking_active_assignment).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="620" y="220" width="560" height="450" as="geometry"/>
                </mxCell>
                <mxCell id="rel_guard" value="1. Registra ingreso con placa sanitizada (HTTP 201)&lt;br&gt;2. Realiza checkout con reversión a libre (HTTP 200)&lt;br&gt;3. Filtra cupos por estado (Available, Occupied)&lt;br&gt;4. Resuelve carreras concurrentes (HTTP 409)&lt;br&gt;&lt;b&gt;[HTTPS / UI Angular 19 :9001]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2.5;fontColor=#0F172A;" parent="1" source="actor_guard" target="system_domonow" edge="1">
                    <mxGeometry x="-0.0909" y="66" relative="1" as="geometry">
                        <mxPoint x="-56" y="-65" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="rel_admin" value="1. Consulta resumen de asignaciones activas&lt;br&gt;2. Monitorea matriz de demanda 24x7 y rotación&lt;br&gt;3. Audita eventos en tiempo real&lt;br&gt;&lt;b&gt;[HTTPS / UI Vue 3 :9002]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2.5;fontColor=#0F172A;" parent="1" source="actor_admin" target="system_domonow" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="box_spec_trace" value="&lt;b&gt;Trazabilidad de Requerimientos OpenSpec (spec.md):&lt;/b&gt;&lt;br&gt;• Req 1: Spot Retrieval &amp; Status Filtering (GET /api/parking-spots?statusFilter=...)&lt;br&gt;• Req 2: Visitor Parking Entry Registration (POST /api/parking-assignments)&lt;br&gt;• Req 3: Parking Spot Checkout &amp; Status Reversion (POST /api/parking-assignments/{id}/checkout)&lt;br&gt;• Req 4: Active Assignments Summary Query (GET /api/parking-assignments/active)&lt;br&gt;• Req 5: High-Concurrency Allocation Control (10 simultaneous requests -&gt; 1 Created, 9 Conflicts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#C084FC;strokeWidth=1.5;fontColor=#4A1E9E;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="520" y="730" width="560" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="c4-containers-diagram" name="C4 Nivel 2 - Diagrama de Contenedores">
        <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" background="#F8FAFC" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <!-- Titulo -->
                <mxCell id="title_block" value="&lt;b style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;DomoNow Visitor Parking Subsystem - Diagrama de Contenedores (C4 Nivel 2)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Arquitectura real implementada: Microfrontends (Single-SPA) y Backend CQRS con Vertical Slices (.NET 10)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="60" y="30" width="1100" height="50" as="geometry"/>
                </mxCell>
                <!-- ACTORES -->
                <mxCell id="act_guard" value="&lt;div style=&quot;font-weight: bold; font-size: 13px;&quot;&gt;Guardia de Garita&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #E2E8F0;&quot;&gt;Opera terminal de portería&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
                    <mxGeometry x="60" y="240" width="160" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="act_admin" value="&lt;div style=&quot;font-weight: bold; font-size: 13px;&quot;&gt;Administrador / Supervisor&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #E2E8F0;&quot;&gt;Supervisa ocupación y analítica&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
                    <mxGeometry x="60" y="520" width="160" height="130" as="geometry"/>
                </mxCell>
                <!-- LIMITE DEL SISTEMA: DOMONOW PLATFORM -->
                <mxCell id="group_domonow" value="DomoNow Visitor Parking Subsystem - Límite de la Solución" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=2;dashed=1;fontStyle=1;fontSize=14;fontColor=#475569;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1">
                    <mxGeometry x="270" y="100" width="1460" height="980" as="geometry"/>
                </mxCell>
                <!-- ========================================== -->
                <!-- SUB-SISTEMA 1: FRONTEND MICROFRONTENDS     -->
                <!-- ========================================== -->
                <mxCell id="group_frontend" value="Cluster Frontend Microfrontends (Browser Runtime)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
                    <mxGeometry x="300" y="140" width="560" height="900" as="geometry"/>
                </mxCell>
                <!-- Contenedor 1: Root Shell Orchestrator -->
                <mxCell id="mfe_root" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Contenedor: Web App]&lt;br&gt;Root Orchestrator (Single-SPA)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; Vite, TypeScript, Single-SPA Core, HTML5/CSS3&lt;br&gt;&lt;b&gt;Puerto:&lt;/b&gt; 9000&lt;br&gt;&lt;br&gt;• Pantalla de Login estático (guardia@domonow.io / DomoNow2026!) con píldora demo.&lt;br&gt;• Gestión de sesión en localStorage y botón de Cerrar Sesión (#btn-logout).&lt;br&gt;• Conmutador bilingüe reactivo [ 🇪🇸 ESP | 🇺🇸 ENG ] sin recarga.&lt;br&gt;• Barra institucional superior con logo oficial (domonow-logo-320.webp).&lt;br&gt;• Orquestador de montaje condicional de microfrontends según autenticación.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="330" y="190" width="500" height="190" as="geometry"/>
                </mxCell>
                <!-- Contenedor 2: Angular 19 Parking Operations MFE -->
                <mxCell id="mfe_angular" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Contenedor: Microfrontend]&lt;br&gt;Operaciones de Garita (Angular 19)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; Angular 19, TypeScript, Angular Signals, RxJS&lt;br&gt;&lt;b&gt;Puerto:&lt;/b&gt; 9001 (/parking)&lt;br&gt;&lt;br&gt;&lt;b&gt;Implementa Requerimientos spec.md:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Req 1:&lt;/b&gt; Grilla de 30 cupos (P-01 a P-30) con filtros (Todos, Disponibles, Ocupados, Fuera de Servicio).&lt;br&gt;• &lt;b&gt;Req 2:&lt;/b&gt; Modal de ingreso con sanitización de placa (regex ^[A-Z0-9]{5,8}$) y asignación de bahía.&lt;br&gt;• &lt;b&gt;Req 3:&lt;/b&gt; Modal de checkout con cálculo de tiempo y reversión a Disponible.&lt;br&gt;• &lt;b&gt;Req 5:&lt;/b&gt; Simulador de ráfaga concurrente anti-carreras para cupo P-15.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD0031;strokeColor=#A60024;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="330" y="420" width="500" height="190" as="geometry"/>
                </mxCell>
                <!-- Contenedor 3: Vue 3 Analytics & Demand MFE -->
                <mxCell id="mfe_vue" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Contenedor: Microfrontend]&lt;br&gt;Analítica y Monitoreo (Vue 3)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; Vue 3, Vite, Pinia, ONNX Runtime Web&lt;br&gt;&lt;b&gt;Puerto:&lt;/b&gt; 9002 (/analytics)&lt;br&gt;&lt;br&gt;&lt;b&gt;Implementa Requerimientos spec.md:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Req 4:&lt;/b&gt; Resumen de asignaciones activas (placas, unidades, tiempo transcurrido).&lt;br&gt;• KPIs de visitas registradas hoy, turnaround promedio y tasa de ocupación.&lt;br&gt;• Matriz de demanda semanal 24x7 (Heatmap) y curva horaria estimada.&lt;br&gt;• Feed de eventos en tiempo real sincronizado por el bus inter-MFE.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#41B883;strokeColor=#2F855E;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="330" y="650" width="500" height="190" as="geometry"/>
                </mxCell>
                <!-- Contenedor 4: Shared UI Tokens Package -->
                <mxCell id="pkg_tokens" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 4px;&quot;&gt;[Librería de Componentes &amp; Tokens]&lt;br&gt;@domonow/ui-tokens&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #4A1E9E;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; CSS Tokens, TypeScript Shared Types, i18n Dictionaries&lt;br&gt;Garantiza identidad visual consistente (#6C35DE, Plus Jakarta Sans, Spacing tokens) y diccionario compartido ESP/ENG.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#C084FC;strokeWidth=2;fontColor=#4A1E9E;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="330" y="870" width="500" height="110" as="geometry"/>
                </mxCell>
                <!-- ========================================== -->
                <!-- SUB-SISTEMA 2: BACKEND CQRS & PERSISTENCIA -->
                <!-- ========================================== -->
                <mxCell id="group_backend" value="Cluster Backend (.NET 10 LTS &amp; PostgreSQL 17)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
                    <mxGeometry x="920" y="140" width="770" height="900" as="geometry"/>
                </mxCell>
                <!-- Backend API Gateway -->
                <mxCell id="api_backend" value="&lt;div style=&quot;font-weight: bold; font-size: 16px; margin-bottom: 6px;&quot;&gt;[Contenedor: Web API]&lt;br&gt;DomoNow Parking API (.NET 10)&lt;/div&gt;&lt;div style=&quot;font-size: 12px; line-height: 1.5; color: #F8FAFC; text-align: left; padding: 0 15px;&quot;&gt;&lt;b&gt;Arquitectura:&lt;/b&gt; Vertical Slice Architecture + CQRS + MediatR&lt;br&gt;&lt;b&gt;Framework:&lt;/b&gt; ASP.NET Core Minimal APIs, C# 14, FluentValidation&lt;br&gt;&lt;br&gt;&lt;b&gt;Casos de Uso Verticales Implementados (spec.md):&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;GetParkingSpotsQuery:&lt;/b&gt; GET /api/parking-spots?statusFilter=...&lt;br&gt;2. &lt;b&gt;RegisterParkingEntryCommand:&lt;/b&gt; POST /api/parking-assignments (Valida regex ^[A-Z0-9]{5,8}$, previene colisiones con HTTP 409).&lt;br&gt;3. &lt;b&gt;RegisterParkingCheckoutCommand:&lt;/b&gt; POST /api/parking-assignments/{id}/checkout (Verifica ExitTime &gt;= EntryTime, restaura Disponible).&lt;br&gt;4. &lt;b&gt;GetActiveAssignmentsQuery:&lt;/b&gt; GET /api/parking-assignments/active&lt;br&gt;5. &lt;b&gt;ConcurrencyRaceControl:&lt;/b&gt; Bloqueo optimista xmin + HTTP 409 Conflict.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#512BD4;strokeColor=#3A1C9E;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="960" y="220" width="690" height="310" as="geometry"/>
                </mxCell>
                <!-- Base de Datos: PostgreSQL 17 -->
                <mxCell id="db_postgres" value="&lt;div style=&quot;font-weight: bold; font-size: 15px; margin-bottom: 6px;&quot;&gt;[Base de Datos Relacional]&lt;br&gt;PostgreSQL 17 Database&lt;/div&gt;&lt;div style=&quot;font-size: 12px; line-height: 1.5; color: #E2E8F0; text-align: left; padding: 0 15px;&quot;&gt;&lt;b&gt;Tablas Mapeadas (open-spec/06-database-ddl.sql):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;parking_spots:&lt;/b&gt; 30 cupos comunales (P-01 a P-30) con token de concurrencia xmin.&lt;br&gt;• &lt;b&gt;parking_assignments:&lt;/b&gt; Historial y asignaciones activas.&lt;br&gt;&lt;br&gt;&lt;b&gt;Restricción Invariante Física de Exclusión (spec.md Req 2 &amp; 5):&lt;/b&gt;&lt;br&gt;&lt;code&gt;CREATE UNIQUE INDEX uq_parking_active_assignment&lt;br&gt;ON parking_assignments (parking_spot_id) WHERE status = 1;&lt;/code&gt;&lt;br&gt;Garantiza matemáticamente que nunca existan 2 vehículos activos en el mismo cupo.&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#2D72D9;strokeColor=#1C4E96;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="960" y="600" width="690" height="300" as="geometry"/>
                </mxCell>
                <!-- ========================================== -->
                <!-- RELACIONES ENTRE CONTENEDORES              -->
                <!-- ========================================== -->
                <!-- Actores -> Root Orchestrator -->
                <mxCell id="rel_act_root" value="Accede al Login institucional&lt;br&gt;&lt;b&gt;[HTTPS:9000]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.35;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;" edge="1" parent="1" source="act_guard" target="mfe_root">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="rel_act_admin" value="Supervisa métricas y analítica&lt;br&gt;&lt;b&gt;[HTTPS:9000]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;" edge="1" parent="1" source="act_admin" target="mfe_root">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Root -> Angular MFE -->
                <mxCell id="rel_root_ang" value="Monta bajo /parking si authenticated&lt;br&gt;&lt;b&gt;[postMessage / Single-SPA]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6C35DE;strokeWidth=2;fontColor=#4A1E9E;" edge="1" parent="1" source="mfe_root" target="mfe_angular">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Root -> Vue MFE -->
                <mxCell id="rel_root_vue" value="Monta bajo /analytics si authenticated&lt;br&gt;&lt;b&gt;[postMessage / Sincronización ESP/ENG]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6C35DE;strokeWidth=2;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;fontColor=#4A1E9E;" edge="1" parent="1" source="mfe_root" target="mfe_vue">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Tokens -> MFEs -->
                <mxCell id="rel_tokens_ang" value="Aplica tokens de diseño" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;strokeColor=#C084FC;" edge="1" parent="1" source="pkg_tokens" target="mfe_vue">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Angular MFE -> Backend API -->
                <mxCell id="rel_ang_api" value="Ejecuta Comandos y Consultas (Req 1, 2, 3, 5)&lt;br&gt;&lt;b&gt;[REST / JSON - HTTP POST / GET]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;strokeColor=#512BD4;strokeWidth=2;fontColor=#1E293B;" edge="1" parent="1" source="mfe_angular" target="api_backend">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Vue MFE -> Backend API -->
                <mxCell id="rel_vue_api" value="Consulta Resumen Activo y Demanda (Req 4)&lt;br&gt;&lt;b&gt;[REST / JSON - HTTP GET]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;strokeColor=#512BD4;strokeWidth=2;fontColor=#1E293B;" edge="1" parent="1" source="mfe_vue" target="api_backend">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Backend API -> PostgreSQL -->
                <mxCell id="rel_api_db" value="Persiste con EF Core 10 y Npgsql&lt;br&gt;Aplica bloqueo optimista xmin y uq_parking_active_assignment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2D72D9;strokeWidth=2.5;" edge="1" parent="1" source="api_backend" target="db_postgres">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="c4-components-diagram" name="C4 Nivel 3 - Diagrama de Componentes">
        <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" background="#F8FAFC" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <!-- Titulo -->
                <mxCell id="title_block" value="&lt;b style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;DomoNow Visitor Parking Subsystem - Diagrama de Componentes (C4 Nivel 3)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Alineado estrictamente a los 5 requerimientos de open-spec/specs/visitor-parking/spec.md y UIs implementadas&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="60" y="30" width="1250" height="50" as="geometry"/>
                </mxCell>
                <!-- ========================================================================= -->
                <!-- SECCION 1: COMPONENTES FRONTEND (MICROFRONTENDS IMPLEMENTADOS)            -->
                <!-- ========================================================================= -->
                <mxCell id="box_fe_cluster" value="Cluster Frontend Microfrontends (Browser Runtime)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
                    <mxGeometry x="60" y="100" width="840" height="1220" as="geometry"/>
                </mxCell>
                <!-- 1.1 Root Config Components -->
                <mxCell id="box_root_components" value="Contenedor 1: Root Shell Orchestrator (:9000)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#1E40AF;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="90" y="140" width="780" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="c_auth" value="&lt;b&gt;AuthController&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[TypeScript / HTML5]&lt;/span&gt;&lt;br&gt;Gestiona login estático (guardia@domonow.io / DomoNow2026!), píldora demo, persistencia de sesión en localStorage y botón de Cerrar Sesión (#btn-logout)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="110" y="180" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_router" value="&lt;b&gt;SingleSpaRouter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[Single-SPA Core]&lt;/span&gt;&lt;br&gt;Condiciona activeWhen con isAuthenticated(). Monta dinámicamente Angular (/parking) o Vue (/analytics) y oculta el login." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="370" y="180" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_i18n_root" value="&lt;b&gt;I18nCoordinator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[CustomEvent / postMessage]&lt;/span&gt;&lt;br&gt;Conmutador [ 🇪🇸 ESP | 🇺🇸 ENG ], actualiza el navbar con logo oficial y sincroniza el idioma a los microfrontends sin recarga." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="630" y="180" width="220" height="90" as="geometry"/>
                </mxCell>
                <!-- 1.2 Angular 19 Parking Components -->
                <mxCell id="box_angular_components" value="Contenedor 2: Microfrontend Angular 19 - Operaciones de Garita (:9001)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#991B1B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="90" y="400" width="780" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="c_ang_grid" value="&lt;b&gt;ParkingGridComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;[spec.md Req 1: Spot Retrieval &amp; Filter]&lt;/span&gt;&lt;br&gt;Grilla de 30 cupos (P-01 a P-30) con filtrado reactivo por statusFilter (Todos, Disponibles, Ocupados, Fuera de Servicio)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="110" y="440" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_ang_modals" value="&lt;b&gt;Entry &amp; Checkout Modals&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;[spec.md Req 2 &amp; 3: Entry &amp; Checkout]&lt;/span&gt;&lt;br&gt;Sanitización de placa con regex ^[A-Z0-9]{5,8}$, registro de visitante/unidad y checkout con cálculo de tiempo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="370" y="440" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_ang_concurrency" value="&lt;b&gt;ConcurrencySimulator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;[spec.md Req 5: Concurrency Control]&lt;/span&gt;&lt;br&gt;Simulador de 10 peticiones concurrentes para cupo P-15 (1 éxito 201 Created y 9 rechazos con 409 Conflict)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="630" y="440" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_ang_service" value="&lt;b&gt;ParkingService (Signal Store)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[Angular Signals]&lt;/span&gt;&lt;br&gt;Estado reactivo de cupos, contadores de disponibilidad y emisión de eventos de asignación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="230" y="560" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_ang_i18n" value="&lt;b&gt;Angular I18nService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[Signal I18n Adapter]&lt;/span&gt;&lt;br&gt;Escucha postMessage de idioma y traduce en vivo grilla, botones y modales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="520" y="560" width="240" height="90" as="geometry"/>
                </mxCell>
                <!-- 1.3 Vue 3 Analytics Components -->
                <mxCell id="box_vue_components" value="Contenedor 3: Microfrontend Vue 3 - Analítica y Demanda (:9002)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="90" y="820" width="780" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="c_vue_heatmap" value="&lt;b&gt;DemandHeatmapComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[Vue 3 SFC]&lt;/span&gt;&lt;br&gt;Matriz de calor semanal 24x7 (7 días x 5 franjas horarias) de saturación de parqueaderos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="110" y="860" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_vue_forecaster" value="&lt;b&gt;PeakHourForecaster&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[Vue 3 SFC / Chart]&lt;/span&gt;&lt;br&gt;Curva estimada de demanda horaria (06:00 a 22:00) y tarjeta de especificaciones ONNX." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="370" y="860" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_vue_feed" value="&lt;b&gt;ActivityFeedComponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;[Vue 3 SFC]&lt;/span&gt;&lt;br&gt;Feed reactivo de eventos en tiempo real (ingresos y checkouts sincronizados con garita)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="630" y="860" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_vue_store" value="&lt;b&gt;AnalyticsStore (Pinia)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #047857;&quot;&gt;[spec.md Req 4: Active Assignments Query]&lt;/span&gt;&lt;br&gt;Almacena resumen de asignaciones activas, tiempo transcurrido, turnaround y visitas hoy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="270" y="990" width="430" height="90" as="geometry"/>
                </mxCell>
                <!-- ========================================================================= -->
                <!-- SECCION 2: COMPONENTES BACKEND (EXACTAMENTE LOS CASOS DE USO DE SPEC.MD)   -->
                <!-- ========================================================================= -->
                <mxCell id="box_be_cluster" value="Cluster Backend: Vertical Slice Architecture con CQRS (.NET 10 LTS)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#DDD6FE;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#4A1E9E;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
                    <mxGeometry x="960" y="100" width="1180" height="1220" as="geometry"/>
                </mxCell>
                <!-- 2.1 Pipeline MediatR y Middleware -->
                <mxCell id="box_pipeline" value="Pipeline de Aplicación (MediatR Behaviors &amp; Exception Middleware)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#C084FC;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#6B21A8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="990" y="140" width="1120" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c_pipe_val" value="&lt;b&gt;ValidationBehavior&lt;/b&gt;&lt;br&gt;Ejecuta FluentValidation (regex placa ^[A-Z0-9]{5,8}$)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="175" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="c_pipe_log" value="&lt;b&gt;LoggingBehavior&lt;/b&gt;&lt;br&gt;Trazabilidad y performance de handlers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1300" y="175" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="c_pipe_ex" value="&lt;b&gt;ExceptionHandlingMiddleware&lt;/b&gt;&lt;br&gt;Mapea: Concurrencia -&amp;gt; 409 Conflict | Validaciones -&amp;gt; 422 | Temporal -&amp;gt; 400" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1570" y="175" width="520" height="60" as="geometry"/>
                </mxCell>
                <!-- 2.2 VERTICAL SLICE 1: RegisterParkingEntry (spec.md Req 2 & 5) -->
                <mxCell id="slice_entry" value="&lt;b&gt;[Vertical Slice: RegisterParkingEntry]&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#6C35DE;&quot;&gt;spec.md Req 2 &amp; 5:&lt;/b&gt; Asignación Concurrente de Cupo (Escritura)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C35DE;strokeWidth=2;fontStyle=0;fontSize=12;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="990" y="290" width="540" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="c_entry_ep" value="&lt;b&gt;RegisterEntryEndpoint&lt;/b&gt;&lt;br&gt;POST /api/parking-assignments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E22CE;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="340" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c_entry_cmd" value="&lt;b&gt;RegisterParkingEntryCommand&lt;/b&gt;&lt;br&gt;SpotId, LicensePlate, VisitorName, Unit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E22CE;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1260" y="340" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c_entry_hnd" value="&lt;b&gt;RegisterParkingEntryCommandHandler&lt;/b&gt;&lt;br&gt;1. Sanitiza placa a ^[A-Z0-9]{5,8}$&lt;br&gt;2. Valida estado del cupo en agregados de dominio&lt;br&gt;3. Persiste asignación en UTC retornando HTTP 201 Created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6C35DE;strokeColor=#4A1E9E;fontColor=#FFFFFF;align=center;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="415" width="500" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="c_entry_agg" value="&lt;b&gt;Invariantes de Dominio (spec.md Scenarios):&lt;/b&gt;&lt;br&gt;• Si Status == Occupied -&amp;gt; Throw ConflictException (HTTP 409)&lt;br&gt;• Si Status == OutOfService -&amp;gt; Throw ValidationException (HTTP 422)&lt;br&gt;• Si Placa no cumple regex -&amp;gt; ValidationException (HTTP 422)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6C35DE;align=left;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="525" width="500" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="c_entry_lock" value="&lt;b&gt;Defensa Física de Concurrencia (spec.md Req 5):&lt;/b&gt;&lt;br&gt;Optimistic Token (RowVersion/xmin) + uq_parking_active_assignment&lt;br&gt;(10 peticiones simultáneas -&amp;gt; 1 HTTP 201, 9 HTTP 409)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;align=center;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="630" width="500" height="60" as="geometry"/>
                </mxCell>
                <!-- 2.3 VERTICAL SLICE 2: CompleteCheckout (spec.md Req 3) -->
                <mxCell id="slice_checkout" value="&lt;b&gt;[Vertical Slice: RegisterParkingCheckout]&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#6C35DE;&quot;&gt;spec.md Req 3:&lt;/b&gt; Salida y Reversión a Disponible (Escritura)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C35DE;strokeWidth=2;fontStyle=0;fontSize=12;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="1570" y="290" width="540" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="c_chk_ep" value="&lt;b&gt;CheckoutEndpoint&lt;/b&gt;&lt;br&gt;POST /api/parking-assignments/{id}/checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E22CE;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1590" y="340" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c_chk_cmd" value="&lt;b&gt;RegisterParkingCheckoutCommand&lt;/b&gt;&lt;br&gt;AssignmentId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E22CE;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1860" y="340" width="230" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c_chk_hnd" value="&lt;b&gt;RegisterParkingCheckoutCommandHandler&lt;/b&gt;&lt;br&gt;1. Busca assignment activo (si no existe -&amp;gt; HTTP 404)&lt;br&gt;2. Establece exitTimeUtc y verifica ExitTime &gt;= EntryTime&lt;br&gt;3. Marca Completed y restaura cupo a Available (HTTP 200)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6C35DE;strokeColor=#4A1E9E;fontColor=#FFFFFF;align=center;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1590" y="415" width="500" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="c_chk_agg" value="&lt;b&gt;Invariantes Temporales (spec.md Scenarios):&lt;/b&gt;&lt;br&gt;• Si ExitTime &lt; EntryTime -&amp;gt; Throw DomainException (HTTP 400 Bad Request)&lt;br&gt;• Si Assignment no existe -&amp;gt; Throw NotFoundException (HTTP 404)&lt;br&gt;• Retorna duración de estancia calculada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6C35DE;align=left;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="1590" y="525" width="500" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.4 VERTICAL SLICE 3: GetParkingSpots (spec.md Req 1) -->
                <mxCell id="slice_query_spots" value="&lt;b&gt;[Vertical Slice: GetParkingSpotsQuery]&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#0284C7;&quot;&gt;spec.md Req 1:&lt;/b&gt; Consulta y Filtro de 30 Cupos (Lectura)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;fontStyle=0;fontSize=12;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="990" y="740" width="540" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="c_q_ep" value="&lt;b&gt;GetSpotsEndpoint&lt;/b&gt;&lt;br&gt;GET /api/parking-spots?statusFilter=..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="790" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c_q_hnd" value="&lt;b&gt;GetParkingSpotsQueryHandler&lt;/b&gt;&lt;br&gt;Consulta optimizada sin tracking. Retorna HTTP 200 con cupos (P-01 a P-30), estado y asignación activa si está ocupado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="860" width="500" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="c_q_dto" value="&lt;b&gt;List&amp;lt;ParkingSpotDto&amp;gt;&lt;/b&gt; (Id, SpotNumber, Status, ActiveAssignment?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="935" width="500" height="45" as="geometry"/>
                </mxCell>
                <!-- 2.5 VERTICAL SLICE 4: GetActiveAssignments (spec.md Req 4) -->
                <mxCell id="slice_active_query" value="&lt;b&gt;[Vertical Slice: GetActiveAssignmentsQuery]&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#0284C7;&quot;&gt;spec.md Req 4:&lt;/b&gt; Resumen de Asignaciones Activas (Lectura)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;fontStyle=0;fontSize=12;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="1570" y="740" width="540" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="c_act_ep" value="&lt;b&gt;GetActiveAssignmentsEndpoint&lt;/b&gt;&lt;br&gt;GET /api/parking-assignments/active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1590" y="790" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c_act_hnd" value="&lt;b&gt;GetActiveAssignmentsQueryHandler&lt;/b&gt;&lt;br&gt;Retorna HTTP 200 con asignaciones activas: número de cupo, placa, nombre de visitante, apartamento de destino y minutos transcurridos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1590" y="860" width="500" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="c_act_dto" value="&lt;b&gt;List&amp;lt;ActiveAssignmentSummaryDto&amp;gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1590" y="935" width="500" height="45" as="geometry"/>
                </mxCell>
                <!-- 2.6 Persistencia PostgreSQL 17 (open-spec/06-database-ddl.sql) -->
                <mxCell id="box_db_tables" value="Persistencia PostgreSQL 17 (open-spec/06-database-ddl.sql)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#1E40AF;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="990" y="1030" width="1120" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="c_table_spots" value="&lt;b&gt;Tabla: parking_spots&lt;/b&gt;&lt;br&gt;id (UUID PK), spot_number (VARCHAR 10 UNIQUE), status (INT: 0=Avail, 1=Occ, 2=OutOfServ), xmin (RowVersion Concurrency Token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="1070" width="510" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_table_assign" value="&lt;b&gt;Tabla: parking_assignments&lt;/b&gt;&lt;br&gt;id (UUID PK), parking_spot_id (FK), license_plate (VARCHAR 10), visitor_name, destination_unit, entry_time (UTC), exit_time (UTC), status (1=Active, 2=Completed)&lt;br&gt;&lt;b style=&quot;color:#DC2626;&quot;&gt;Índice Único Parcial: uq_parking_active_assignment (parking_spot_id) WHERE status = 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1570" y="1070" width="510" height="90" as="geometry"/>
