  <diagram id="c4-context-diagram" name="C4 Nivel 1 - Contexto del Sistema">
    <mxGraphModel dx="1422" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Titulo y Metadatos -->
        <mxCell id="title_block" value="&lt;b style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;DomoNow PropTech Platform - Diagrama de Contexto del Sistema (C4 Nivel 1)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Modelo de Arquitectura para el Ecosistema de Gestión de Portería, Visitas y Parqueaderos&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="850" height="50" as="geometry" />
        </mxCell>

        <!-- ACTORES / PERSONAS -->
        <!-- 1. Guardia de Porteria -->
        <mxCell id="actor_guard" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Persona]&lt;br&gt;Guardia de Portería&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Personal de seguridad y control en garita principal. Registra entradas, salidas y autorizaciones vehiculares.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- 2. Residente / Copropietario -->
        <mxCell id="actor_resident" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Persona]&lt;br&gt;Residente / Propietario&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Habitante de la copropiedad. Pre-autoriza visitantes, consulta disponibilidad y recibe notificaciones.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- 3. Administrador de la Copropiedad -->
        <mxCell id="actor_admin" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Persona]&lt;br&gt;Administrador de Copropiedad&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Gestiona políticas de cobro, auditoría de ocupación, reportes analíticos y tarifas de parqueadero.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- 4. Visitante Vehicular -->
        <mxCell id="actor_visitor" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Persona]&lt;br&gt;Visitante Vehicular&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Conductor que ingresa al conjunto a visitar una unidad residencial temporalmente.&lt;/div&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="810" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- SISTEMA CENTRAL: DOMONOW PLATFORM -->
        <mxCell id="system_domonow" value="&lt;div style=&quot;font-weight: bold; font-size: 18px; margin-bottom: 8px;&quot;&gt;[Sistema de Software]&lt;br&gt;DomoNow PropTech Platform&lt;/div&gt;&lt;div style=&quot;font-size: 12px; line-height: 1.5; color: #F1F5F9;&quot;&gt;Plataforma integral de control de acceso vehicular, administración de parqueaderos comunales, asignación concurrente en tiempo real, predicción de saturación con Machine Learning y liquidación tarifaria.&lt;br&gt;&lt;br&gt;&lt;b&gt;Arquitectura:&lt;/b&gt; Microfrontends (Single-SPA, Angular 19, Vue 3) + Backend CQRS con Vertical Slice Architecture (.NET 10).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="340" width="380" height="340" as="geometry" />
        </mxCell>

        <!-- SISTEMAS EXTERNOS -->
        <!-- 1. Sistema LPR Camaras -->
        <mxCell id="ext_lpr" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Sistema Externo]&lt;br&gt;Cámaras LPR &amp; Sensores IoT&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Reconocimiento automático de placas vehiculares en carril de desaceleración.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="190" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- 2. Talanqueras y Barreras IoT -->
        <mxCell id="ext_gates" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Sistema Externo]&lt;br&gt;Barreras Vehiculares IoT&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Controladores físicos de apertura y cierre de talanqueras por relé / protocolo MQTT.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="380" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- 3. Pasarela de Notificaciones -->
        <mxCell id="ext_notifications" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Sistema Externo]&lt;br&gt;Pasarela de Mensajería&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;WhatsApp Cloud API, SMS y Notificaciones Push (Firebase Cloud Messaging).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="570" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- 4. Pasarela de Pagos -->
        <mxCell id="ext_payments" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Sistema Externo]&lt;br&gt;Pasarela de Pagos (Wompi / PSE)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Procesamiento de pagos electrónicos por fracciones de estacionamiento de visitantes.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="760" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- RELACIONES / CONEXIONES -->
        <!-- Guardia -> DomoNow -->
        <mxCell id="rel_guard" value="Opera asignaciones en vivo,&lt;br&gt;gestiona checkout y resuelve carreras&lt;br&gt;&lt;b&gt;[HTTPS / WebSockets]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;fontColor=#0F172A;" edge="1" parent="1" source="actor_guard" target="system_domonow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Residente -> DomoNow -->
        <mxCell id="rel_resident" value="Pre-autoriza placas y&lt;br&gt;consulta cupos disponibles&lt;br&gt;&lt;b&gt;[HTTPS / REST]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.45;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;fontColor=#0F172A;" edge="1" parent="1" source="actor_resident" target="system_domonow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Admin -> DomoNow -->
        <mxCell id="rel_admin" value="Consulta analítica predictiva,&lt;br&gt;audita ocupación y configura tarifas&lt;br&gt;&lt;b&gt;[HTTPS]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;fontColor=#0F172A;" edge="1" parent="1" source="actor_admin" target="system_domonow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Visitante -> DomoNow -->
        <mxCell id="rel_visitor" value="Paga fracción de parqueadero&lt;br&gt;vía QR de portería&lt;br&gt;&lt;b&gt;[Web Responsive / HTTPS]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.9;entryDx=0;entryDy=0;strokeColor=#08427B;strokeWidth=2;fontColor=#0F172A;" edge="1" parent="1" source="actor_visitor" target="system_domonow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DomoNow -> LPR -->
        <mxCell id="rel_lpr" value="Recibe evento de placa detectada&lt;br&gt;&lt;b&gt;[Webhook / MQTT]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#0F172A;" edge="1" parent="1" source="system_domonow" target="ext_lpr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DomoNow -> Talanqueras -->
        <mxCell id="rel_gates" value="Ordena apertura al asignar cupo&lt;br&gt;&lt;b&gt;[MQTT / Relay API]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#0F172A;" edge="1" parent="1" source="system_domonow" target="ext_gates">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DomoNow -> Notificaciones -->
        <mxCell id="rel_notif" value="Envía aviso de llegada al residente&lt;br&gt;&lt;b&gt;[REST / HTTPS]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#0F172A;" edge="1" parent="1" source="system_domonow" target="ext_notifications">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DomoNow -> Pagos -->
        <mxCell id="rel_pay" value="Genera cobro por estadía vehicular&lt;br&gt;&lt;b&gt;[REST / Webhooks]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#0F172A;" edge="1" parent="1" source="system_domonow" target="ext_payments">
          <mxGeometry relative="1" as="geometry" />
