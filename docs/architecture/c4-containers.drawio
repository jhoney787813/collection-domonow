        <!-- ========================================== -->
        <!-- SUB-SISTEMA 1: FRONTEND MICROFRONTENDS     -->
        <!-- ========================================== -->
        <mxCell id="group_frontend" value="Cluster Frontend Microfrontends (Browser Runtime)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="560" height="1040" as="geometry" />
        </mxCell>

        <!-- Contenedor 1: Root Shell Orchestrator -->
        <mxCell id="mfe_root" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Contenedor: Web App]&lt;br&gt;Root Orchestrator (Single-SPA)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; Vite, TypeScript, Single-SPA Core, HTML5/CSS3&lt;br&gt;&lt;b&gt;Puerto:&lt;/b&gt; 9000&lt;br&gt;&lt;br&gt;Gestiona la pantalla inicial de Login estático, sesión en localStorage, navbar institucional, conmutación bilingüe ESP/ENG y orquestación de ciclo de vida de microfrontends.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="190" width="500" height="170" as="geometry" />
        </mxCell>

        <!-- Contenedor 2: Angular 19 Parking Operations MFE -->
        <mxCell id="mfe_angular" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Contenedor: Microfrontend]&lt;br&gt;Operaciones de Parqueadero&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; Angular 19, TypeScript, Angular Signals, RxJS&lt;br&gt;&lt;b&gt;Puerto:&lt;/b&gt; 9001 (/parking)&lt;br&gt;&lt;br&gt;Tablero de control en tiempo real para portería: grilla reactiva de 30 cupos, modales de ingreso/salida, normalización de placas y simulación de ráfaga concurrente anti-carreras.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD0031;strokeColor=#A60024;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="500" height="170" as="geometry" />
        </mxCell>

        <!-- Contenedor 3: Vue 3 Analytics & Demand MFE -->
        <mxCell id="mfe_vue" value="&lt;div style=&quot;font-weight: bold; font-size: 14px; margin-bottom: 4px;&quot;&gt;[Contenedor: Microfrontend]&lt;br&gt;Analítica Predictiva &amp; Demanda&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; Vue 3, Vite, Pinia, ONNX Runtime Web&lt;br&gt;&lt;b&gt;Puerto:&lt;/b&gt; 9002 (/analytics)&lt;br&gt;&lt;br&gt;Panel de inteligencia operativa: matriz de calor de demanda 24x7, curva horaria estimada, inferencia ML de saturación inminente y feed reactivo de eventos inter-MFE.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#41B883;strokeColor=#2F855E;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="650" width="500" height="170" as="geometry" />
        </mxCell>

        <!-- Contenedor 4: Shared UI Tokens Package -->
        <mxCell id="pkg_tokens" value="&lt;div style=&quot;font-weight: bold; font-size: 13px; margin-bottom: 4px;&quot;&gt;[Librería de Componentes &amp; Tokens]&lt;br&gt;@domonow/ui-tokens&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #4A1E9E;&quot;&gt;&lt;b&gt;Tecnología:&lt;/b&gt; CSS Tokens, TypeScript Shared Types, i18n Dictionaries&lt;br&gt;Garantiza coherencia visual institucional (Paleta #6C35DE, Plus Jakarta Sans, Spacing tokens).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#C084FC;strokeWidth=2;fontColor=#4A1E9E;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="880" width="500" height="110" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- SUB-SISTEMA 2: BACKEND CQRS & SLICES       -->
        <!-- ========================================== -->
        <mxCell id="group_backend" value="Cluster Backend (.NET 10 LTS &amp; Persistencia)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="140" width="770" height="1040" as="geometry" />
        </mxCell>

        <!-- Backend API Gateway -->
        <mxCell id="api_backend" value="&lt;div style=&quot;font-weight: bold; font-size: 16px; margin-bottom: 6px;&quot;&gt;[Contenedor: Backend Web API]&lt;br&gt;DomoNow Parking API (.NET 10)&lt;/div&gt;&lt;div style=&quot;font-size: 12px; line-height: 1.5; color: #F8FAFC;&quot;&gt;&lt;b&gt;Arquitectura:&lt;/b&gt; Vertical Slice Architecture + CQRS + MediatR&lt;br&gt;&lt;b&gt;Framework:&lt;/b&gt; ASP.NET Core Minimal APIs, C# 14, FluentValidation&lt;br&gt;&lt;br&gt;Cada caso de uso está encapsulado en un slice independiente (Comandos y Consultas segregadas). Procesa transacciones concurrentes con control optimista (RowVersion / xmin) y expone contratos RESTful / OpenAPI.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#512BD4;strokeColor=#3A1C9E;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="240" width="690" height="230" as="geometry" />
        </mxCell>

        <!-- Base de Datos: PostgreSQL 16 -->
        <mxCell id="db_postgres" value="&lt;div style=&quot;font-weight: bold; font-size: 15px; margin-bottom: 4px;&quot;&gt;[Base de Datos Relacional]&lt;br&gt;PostgreSQL 16 Engine&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;&lt;b&gt;Write &amp; Read Store:&lt;/b&gt;&lt;br&gt;- parking_spots (Cupos 1..30)&lt;br&gt;- parking_assignments (Historial de estancias)&lt;br&gt;- audit_logs (Trazabilidad y seguridad)&lt;br&gt;&lt;br&gt;&lt;b&gt;Restricción Invariante Física:&lt;/b&gt;&lt;br&gt;uq_parking_active_assignment (Garantía física anti-colisión)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#2D72D9;strokeColor=#1C4E96;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="550" width="310" height="260" as="geometry" />
        </mxCell>

        <!-- Cache Distribuido: Redis -->
        <mxCell id="cache_redis" value="&lt;div style=&quot;font-weight: bold; font-size: 15px; margin-bottom: 4px;&quot;&gt;[Cache en Memoria]&lt;br&gt;Redis Distributed Cache&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Snapshot de disponibilidad de cupos en tiempo real y resultados de consultas de alta frecuencia.&lt;br&gt;&lt;br&gt;&lt;b&gt;Latencia:&lt;/b&gt; &amp;lt; 2 ms&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DC2626;strokeColor=#991B1B;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
