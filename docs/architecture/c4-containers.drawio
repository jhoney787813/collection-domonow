        <mxCell id="leg_person" value="&lt;b&gt;Persona&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px;&quot;&gt;Usuario / Actor&lt;/span&gt;" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="950" width="95" height="70" as="geometry" />
        </mxCell>

        <mxCell id="leg_container" value="&lt;b&gt;Contenedor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px;&quot;&gt;App ejecutable&lt;/span&gt;" style="shape=mxgraph.c4.container2;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="950" width="105" height="70" as="geometry" />
        </mxCell>

        <mxCell id="leg_db" value="&lt;b&gt;Base de Datos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px;&quot;&gt;Almacén de datos&lt;/span&gt;" style="shape=mxgraph.c4.database;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1210" y="950" width="105" height="70" as="geometry" />
        </mxCell>

        <mxCell id="leg_lib" value="&lt;b&gt;Librería / Tokens&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px;&quot;&gt;Módulo compartido&lt;/span&gt;" style="shape=mxgraph.c4.container2;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;align=center;verticalAlign=top;spacingTop=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="950" width="115" height="70" as="geometry" />
        </mxCell>

        <mxCell id="leg_rel" value="&lt;b&gt;Relación C4&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;[Protocolo]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#333333;fontSize=10;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
